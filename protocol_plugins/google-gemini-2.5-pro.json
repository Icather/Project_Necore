{
  "provider_info": {
    "id": "gemini-2.5-pro",
    "display_name": "Gemini 2.5 Pro (Google)",
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "is_openai_compatible": true,
    "available_models": ["gemini-2.5-pro", "gemini-2.5-flash", "gemini-2.0-flash", "gemini-2.0-flash-lite"]
  },
  "feature_reasoning": {
    "supported": true,
    "trigger_type": "extra_body",
    "trigger_payload": {"google": {"thinking_config": {"include_thoughts": true}}},
    "response_field": "reasoning_content",
    "allows_temperature": true
  },
  "feature_cache": {
    "supported": false
  },
  "feature_vision": {
    "supported": true,
    "max_images_per_request": 16,
    "detail_control_supported": false,
    "input_format": "base64"
  },
  "feature_tools": {
    "supported": true,
    "strict_mode_supported": false,
    "parallel_tool_calls_supported": true
  },
  "feature_structured_output": {
    "json_mode_supported": true,
    "requires_json_keyword_in_prompt": false
  },
  "feature_roles": {
    "system_role_name": "system",
    "supports_system_role": true
  },
  "feature_streaming": {
    "supported": true
  },
  "billing_metadata": {
    "input_price_per_1m": 1.25,
    "output_price_per_1m": 10.0,
    "cache_hit_price_per_1m": 0.0
  },
  "constraints": {
    "max_input_tokens": 1048576,
    "max_output_tokens": 65536,
    "context_window_safe_threshold": 0.95
  }
}
